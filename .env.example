# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Site Configuration
VITE_SITE_NAME="SRI LAKSHMI NARASIMHA BUILDERS"
VITE_SITE_URL="https://your-domain.com"

# Contact Information
VITE_CONTACT_EMAIL="info@slnbuilders.com"
VITE_CONTACT_PHONE="+91 98765 43210"
VITE_CONTACT_ADDRESS="123 Builder Street, Real Estate District, City - 500001"

# Social Media Links
VITE_FACEBOOK_URL="https://facebook.com/yourpage"
VITE_TWITTER_URL="https://twitter.com/yourhandle"
VITE_INSTAGRAM_URL="https://instagram.com/yourhandle"
VITE_LINKEDIN_URL="https://linkedin.com/company/yourcompany"
VITE_YOUTUBE_URL="https://youtube.com/yourchannel"

# Google Maps (Optional)
VITE_GOOGLE_MAPS_API_KEY="your-api-key-here"
VITE_GOOGLE_MAPS_EMBED_URL="your-embed-url"

# Analytics (Optional)
VITE_GA_TRACKING_ID="G-XXXXXXXXXX"

# Contact form API endpoint.
# Leave unset for default behavior: in `npm run dev` this hits the local
# Express server via the Vite proxy (see vite.config.js); in a Netlify
# production build it hits /api/contact, which netlify.toml redirects to
# the Netlify Function at netlify/functions/contact.js.
# Only set this if the backend lives on a different host.
# VITE_API_URL="https://api.your-domain.com/api/contact"

# Note: Variables prefixed with VITE_ are exposed to the client
# Never commit the actual .env file to version control

# Phase 3/4
VITE_CMS_API_URL=
VITE_SITE_URL=https://your-domain.example
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_WHATSAPP_NUMBER=919989625479
