# Email Configuration for Backend Server
# Copy this file to .env and fill in your actual values

# Server Port
PORT=3001

# SMTP host/port (defaults to Gmail if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Gmail Configuration
# Use your Gmail address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate this from: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your-16-character-app-password

# Admin Email (where contact form submissions will be sent)
ADMIN_EMAIL=your-email@gmail.com

# Shared secret required in the `x-admin-key` header to read/delete leads
# via GET/DELETE /api/submissions. Generate a long random string.
ADMIN_API_KEY=change-this-to-a-long-random-string

# Newsletter (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=your_brevo_list_id
BREVO_SENDER_EMAIL=your_verified_sender_email


# Phase 3 JWT admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately
JWT_SECRET=replace-with-a-long-random-secret

# Optional headless CMS API adapter (leave empty to use local content)
CMS_PROVIDER=none
CMS_API_URL=
CMS_API_TOKEN=

# Phase 4 analytics / site settings
SITE_URL=https://your-domain.example
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_WHATSAPP_NUMBER=919989625479
